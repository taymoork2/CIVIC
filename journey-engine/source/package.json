{
  "name": "washcloset",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "ignore"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "ignore"
    }
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "check": "pnpm --recursive run check",
    "test": "pnpm --recursive run test",
    "start:local": "sh apps/web/scripts/serve-local.sh"
  }
}
