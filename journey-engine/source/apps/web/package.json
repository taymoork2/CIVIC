{
  "name": "@washcloset/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "review": "WASHCLOSET_REVIEW=1 VITE_CONVEX_URL=http://127.0.0.1:1 VITE_CONVEX_SITE_URL=http://127.0.0.1:1 vite dev --host 127.0.0.1 --port ${PORT:-3010} --strictPort",
    "test:review": "node --test scripts/review-agents.check.mjs scripts/review-inventory.check.mjs scripts/review-adapter.check.mjs scripts/review-application.check.mjs scripts/review-project.check.mjs scripts/review-projects.check.mjs scripts/review-civic.check.mjs scripts/review-runtime.check.mjs && pnpm --filter @civic/shell run test:server && pnpm --filter @civic/vite-connector test",
    "build": "vite build",
    "build:icons": "node scripts/build-icons.mjs",
    "check": "tsc --noEmit && pnpm run check:styles",
    "check:styles": "node scripts/check-classes.mjs && node scripts/class-collision.mjs",
    "test": "vitest run && node --test scripts/catalog-retrieve.check.mjs scripts/flow-test-account.check.mjs",
    "test:recovery": "python3 -B scripts/trial-recovery.test.py",
    "e2e": "playwright test",
    "e2e:quiet": "node scripts/e2e-quiet.mjs",
    "fixtures": "node scripts/fixture-accounts.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@civic/canvas": "workspace:*",
    "@civic/shell": "workspace:*",
    "@civic/vite-connector": "workspace:*",
    "@convex-dev/better-auth": "0.12.5",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-start": "1.168.58",
    "@vitejs/plugin-react": "6.1.1",
    "@washcloset/planner": "workspace:*",
    "better-auth": "1.6.33",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-rsc": "0.5.35",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
