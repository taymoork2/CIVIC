{
  "motion": {
    "dur-press": { "$type": "duration", "$value": "140ms" },
    "dur-step": { "$type": "duration", "$value": "200ms" },
    "dur-sheet": { "$type": "duration", "$value": "240ms" },
    "ease-out": {
      "$type": "cubicBezier",
      "$value": [0.16, 1, 0.3, 1],
      "$extensions": { "com.washcloset.web": { "css": "cubic-bezier(0.16, 1, 0.3, 1)" } }
    },
    "effect": {
      "$type": "cubicBezier",
      "$value": [0.2, 0, 0, 1],
      "$extensions": { "com.washcloset.web": { "css": "cubic-bezier(0.2, 0, 0, 1)" } }
    },
    "spring": {
      "$description": "Sampled into linear() for the web; provisional native spring constants until measured on device.",
      "$value": "linear(0, 0.13 4%, 0.42 10%, 0.74 17%, 0.95 25%, 1.03 32%, 1.05 38%, 1.03 47%, 1.005 60%, 0.998 75%, 1)",
      "$extensions": {
        "com.washcloset.web": { "css": "linear(0, 0.13 4%, 0.42 10%, 0.74 17%, 0.95 25%, 1.03 32%, 1.05 38%, 1.03 47%, 1.005 60%, 0.998 75%, 1)" },
        "com.washcloset.native": { "stiffness": 210, "damping": 20 }
      }
    },
    "spring-fast": {
      "$description": "Sampled into linear() for the web; provisional native spring constants until measured on device.",
      "$value": "linear(0, 0.3 6%, 0.8 16%, 1.06 27%, 1.08 34%, 1.02 48%, 0.995 65%, 1)",
      "$extensions": {
        "com.washcloset.web": { "css": "linear(0, 0.3 6%, 0.8 16%, 1.06 27%, 1.08 34%, 1.02 48%, 0.995 65%, 1)" },
        "com.washcloset.native": { "stiffness": 320, "damping": 24 }
      }
    }
  }
}
