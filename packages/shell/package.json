{
  "name": "@civic/shell",
  "private": true,
  "type": "module",
  "exports": {
    "./ui/*": "./src/ui/*.tsx",
    "./icons": "./src/icons.ts",
    "./canvas-camera": "./src/canvas-camera.ts",
    "./use-canvas-camera": "./src/use-canvas-camera.ts",
    "./canvas-controls": "./src/canvas-controls.tsx",
    "./reveal-navigation": "./src/reveal-navigation.ts",
    "./contract": "./src/contract.ts",
    "./capture": "./src/capture.ts",
    "./styles/*.css": "./styles/*.css",
    "./server": "./server/review-server.mjs",
    "./server/recording": "./server/review-recording.mjs"
  },
  "scripts": {
    "build:styles": "tailwindcss -i styles/ui.css -o styles/ui.generated.css --minify",
    "check": "tsc --noEmit",
    "test": "vitest run && pnpm run test:server",
    "test:server": "node --test server/review-server.check.mjs server/review-recording.check.mjs server/review-interactions.check.mjs"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@playwright/test": "1.63.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
