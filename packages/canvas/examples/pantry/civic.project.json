{
  "version": 1,
  "id": "pantry-demo",
  "name": "Pantry",
  "adapter": { "kind": "module", "entry": "src/preview.js", "runtime": "server/civic-runtime.js", "extension": "src/canvas-extension.js" },
  "sources": ["src", "server"],
  "scenarios": "civic.scenarios.json",
  "coverage": "civic.coverage.json",
  "personas": [
    { "id": "stocked", "label": "Stocked kitchen", "seed": { "items": [["Rice", 2], ["Olive oil", 1], ["Lentils", 0]] } },
    { "id": "empty", "label": "Empty kitchen", "seed": { "items": [] } }
  ],
  "roles": [{ "id": "cook", "label": "Cook" }, { "id": "guest", "label": "Guest" }],
  "conditions": [{ "id": "normal", "label": "Normal" }, { "id": "backend-down", "label": "Backend unavailable" }],
  "navigation": ["Pantry", "Shopping"]
}
