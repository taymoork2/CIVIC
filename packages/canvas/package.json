{
  "name": "@civic/canvas",
  "private": true,
  "type": "module",
  "bin": {
    "civic-canvas": "./bin/civic-canvas.mjs"
  },
  "exports": {
    ".": "./server/canvas-host.mjs",
    "./root": "./server/canvas-root.mjs",
    "./module-adapter": "./server/module-adapter.mjs",
    "./runtime": "./server/runtime-service.mjs",
    "./journey-graph": "./src/journey-graph.mjs",
    "./adapter": "./src/adapter.ts",
    "./extension": "./src/extension.ts",
    "./journey": "./src/journey.ts",
    "./app-map": "./src/app-map.ts",
    "./project-request": "./src/project-request.ts",
    "./runtime-bridge": "./src/runtime-bridge.ts",
    "./runtime-dom": "./src/runtime-dom.ts",
    "./runtime-session": "./src/runtime-session.ts",
    "./review-api": "./src/review-api.ts",
    "./run-controls": "./src/run-controls.tsx",
    "./viewport-presets": "./src/viewport-presets.ts",
    "./styles/*.css": "./src/*.css"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run && pnpm run test:host",
    "test:host": "node ../../bin/with-temp-root.mjs node --test --test-concurrency=2 server/server-functions.check.mjs server/runtime-service.check.mjs server/canvas-host.check.mjs server/module-adapter.check.mjs server/viewport-controls.check.mjs server/project-picker.check.mjs server/shell-layout.check.mjs server/theme-settings.check.mjs server/shell-design.check.mjs"
  },
  "dependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxc-transform-react": "0.145.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.1"
  },
  "devDependencies": {
    "@civic/shell": "workspace:*",
    "@civic/vite-connector": "workspace:*",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@civic/shell": "*",
    "@civic/vite-connector": "*"
  }
}
