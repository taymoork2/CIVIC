{
  "name": "@civic/canvas",
  "private": true,
  "type": "module",
  "bin": {
    "civic-canvas": "./bin/civic-canvas.mjs"
  },
  "exports": {
    ".": "./server/canvas-host.mjs",
    "./root": "./server/canvas-root.mjs",
    "./module-adapter": "./server/module-adapter.mjs",
    "./runtime": "./server/runtime-service.mjs",
    "./journey-graph": "./src/journey-graph.mjs",
    "./adapter": "./src/adapter.ts",
    "./extension": "./src/extension.ts",
    "./journey": "./src/journey.ts",
    "./app-map": "./src/app-map.ts",
    "./project-request": "./src/project-request.ts",
    "./runtime-bridge": "./src/runtime-bridge.ts",
    "./runtime-dom": "./src/runtime-dom.ts",
    "./runtime-session": "./src/runtime-session.ts",
    "./review-api": "./src/review-api.ts",
    "./run-controls": "./src/run-controls.tsx",
    "./viewport-presets": "./src/viewport-presets.ts",
    "./styles/*.css": "./src/*.css"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "node ../../bin/with-temp-root.mjs vp test run --maxWorkers=2 && pnpm run test:host",
    "test:host": "node ../../bin/with-temp-root.mjs node --test --test-concurrency=2 \"server/*.check.mjs\""
  },
  "dependencies": {
    "effect": "^4.1.4",
    "xstate": "6.0.0-beta.3",
    "@xstate/effect": "1.0.0-beta.2",
    "ws": "^8.23.0",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^6.3.0",
    "oxc-transform-react": "^0.156.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@civic/core": "workspace:*",
    "@types/ws": "8.18.2",
    "@civic/shell": "workspace:*",
    "@civic/vite-connector": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "^19.3.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@civic/shell": "*",
    "@civic/vite-connector": "*"
  }
}
