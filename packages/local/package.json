{
  "name": "@civic/local",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node start.mjs",
    "check": "node ../../bin/with-temp-root.mjs node ../../bin/check-syntax.mjs .",
    "test": "node ../../bin/with-temp-root.mjs node --test --test-concurrency=2 \"*.check.mjs\"",
    "desktop": "node desktop-launch.mjs",
    "test:electron": "node ../../bin/with-temp-root.mjs node --test --test-concurrency=1 \"*.electron.mjs\""
  },
  "dependencies": {
    "@civic/canvas": "workspace:*",
    "@civic/vite-connector": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "vite": "catalog:"
  }
}
