{
  "name": "civic-packages",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "ignore"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "ignore"
    }
  },
  "scripts": {
    "check": "node ../bin/with-temp-root.mjs node ../bin/lint-baseline.mjs && node ../bin/with-temp-root.mjs pnpm --workspace-concurrency=1 --recursive run check",
    "test": "pnpm --workspace-concurrency=1 --recursive run test && node ../bin/with-temp-root.mjs node --test --test-concurrency=2 ../scripts/commit-type.test.ts ../scripts/lint-baseline.test.mjs"
  },
  "devDependencies": {
    "@effect/tsgo": "0.69.0",
    "ultracite": "^8.2.1",
    "vite-plus": "catalog:"
  }
}
