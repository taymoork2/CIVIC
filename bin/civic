#!/usr/bin/env bash
# civic: one command for CIVIC's local tools. Graph queries (validate, forecast, overrides, context,
# gaps, completeness) go to graph/; the review to agent loop (annotate, request, requests, claim,
# report-fix, recapture, repro, resolve and the rest) goes to review/. No model calls.
set -euo pipefail
repo_root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
case "${1:-}" in
  validate|forecast|overrides|context|gaps|completeness) exec node "$repo_root/graph/src/cli.ts" "$@" ;;
  *) exec node "$repo_root/review/src/cli.ts" "$@" ;;
esac
