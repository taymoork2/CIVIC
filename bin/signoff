#!/usr/bin/env bash
# Local signoff: run CIVIC's checks on this machine instead of paid CI minutes, then
# record a green "signoff" commit status on GitHub for the exact commit that passed.
#
#   bin/signoff            graph, review loop, crawl, importer, Fluent Button, Card, rebrand, Laundry and discovery example checks, the
#                          civic check gate, and CIVIC's packages with their install check. Laundry's own
#                          checks run in Laundry's repository (decision 0010). Posts the "signoff" and
#                          "civic" statuses, and on an open pull request a comment listing the findings
#                          this change introduced, with who is asked and who is told (step 10).
#   bin/signoff --browser  also the Fluent Button web evidence (needs Chrome)
#   bin/signoff --capture  first recapture Laundry's evidence if the gate finds it stale (needs
#                          LAUNDRY_CHECKOUT, a clean Laundry checkout, Chrome, and Laundry's review
#                          server started there at its HEAD); a recapture stops the signoff so
#                          the new evidence can be reviewed and committed
#   bin/signoff --no-post  run everything but do not post a status
set -euo pipefail

browser=0 post=1 capture=0
for arg in "$@"; do
  case "$arg" in
    --browser) browser=1 ;;
    --no-post) post=0 ;;
    --capture) capture=1 ;;
    *) echo "Unknown option: $arg" >&2; exit 2 ;;
  esac
done

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
packages_dir="$repo_root/packages"
graph_dir="$repo_root/graph"
importers_dir="$repo_root/importers"
demo_dir="$repo_root/demo/fluent-button"
card_dir="$repo_root/demo/card"
laundry_dir="$repo_root/projects/laundry"
review_dir="$repo_root/review"
crawl_dir="$repo_root/crawl"
discovery_dir="$repo_root/projects/discovery-app"
step() { printf '\n[signoff %s] %s\n' "$(date +%H:%M:%S)" "$1"; }

# A signoff vouches for one commit, so uncommitted changes would make it a false claim.
if [ -n "$(git -C "$repo_root" status --porcelain)" ]; then
  echo "Commit or stash your changes first: a signoff covers exactly the committed HEAD." >&2
  exit 1
fi
sha="$(git -C "$repo_root" rev-parse HEAD)"

# Fixture capture (roadmap step 6): evidence whose code changed since it was captured is
# stale. Recapturing changes the committed inputs, so it ends the signoff for review.
if [ "$capture" = 1 ]; then
  step "Stale evidence: Laundry"
  if [ -z "${LAUNDRY_CHECKOUT:-}" ]; then
    echo "--capture compares Laundry's evidence with Laundry's code: set LAUNDRY_CHECKOUT to a Laundry checkout." >&2
    exit 2
  fi
  pnpm --dir "$graph_dir" install --frozen-lockfile
  stale="$({ "$repo_root/bin/civic" check --config "$repo_root/civic.check.json" --json || true; } | node -e '
    let text = ""; process.stdin.on("data", (chunk) => (text += chunk)).on("end", () => {
      const report = JSON.parse(text)
      const all = [...report.fresh, ...report.baselined, ...report.advisory]
      console.log(all.filter((item) => item.kind === "stale-evidence" && item.graph === "projects/laundry/out/graph.json").length)
    })')"
  if [ "$stale" = 0 ]; then
    echo "Laundry's evidence is fresh; nothing to recapture."
  else
    echo "$stale piece(s) of Laundry's evidence are stale; recapturing."
    pnpm --dir "$review_dir" install --frozen-lockfile
    node "$laundry_dir/capture.ts" --checkout "$LAUNDRY_CHECKOUT" "${WASHCLOSET_E2E_BASE_URL:-http://127.0.0.1:3010}"
    node "$laundry_dir/build.ts"
    git -C "$repo_root" status --short -- projects/laundry
    echo "Recaptured Laundry's evidence at $(git -C "$LAUNDRY_CHECKOUT" rev-parse --short=12 HEAD). Review the diff, commit projects/laundry, and sign off again." >&2
    exit 1
  fi
fi

step "CIVIC graph: types, tests and example graphs"
pnpm --dir "$graph_dir" install --frozen-lockfile
pnpm --dir "$graph_dir" run check
pnpm --dir "$graph_dir" test
pnpm --dir "$graph_dir" run validate

step "CIVIC review to agent loop: store, CLI and re-capture"
pnpm --dir "$review_dir" install --frozen-lockfile
pnpm --dir "$review_dir" run check
pnpm --dir "$review_dir" test

step "CIVIC crawl loop: types and tests (one test drives a browser)"
pnpm --dir "$crawl_dir" install --frozen-lockfile
pnpm --dir "$crawl_dir" run check
pnpm --dir "$crawl_dir" test

step "CIVIC importers, the Fluent Button and Card demo graphs, and the Laundry and discovery example graphs"
pnpm --dir "$importers_dir" install --frozen-lockfile
pnpm --dir "$importers_dir" run check
pnpm --dir "$importers_dir" test
node "$demo_dir/build.ts" --check
node "$card_dir/build.ts" --check
node "$repo_root/demo/rebrand/build.ts" --check
node "$laundry_dir/build.ts" --check
node "$discovery_dir/build.ts" --check

# Roadmap step 10: findings are raised at the change that caused it. The gate also compares
# the graphs with where this branch left its base (CIVIC_BASE, origin/main by default) and
# names who each new finding asks and tells; the same summary goes on the pull request below.
base_ref="${CIVIC_BASE:-origin/main}"
since=()
git -C "$repo_root" rev-parse --verify --quiet "$base_ref^{commit}" >/dev/null && since=(--since "$base_ref")
step "The gate: civic check on the graphs in civic.check.json against civic.baseline.json${since:+ and $base_ref}"
"$repo_root/bin/civic" check --config "$repo_root/civic.check.json" ${since[@]+"${since[@]}"}
if [ "${#since[@]}" -gt 0 ]; then
  # Library releases on this branch (step 10): variants left unmapped and overrides broken.
  # Reported, not gating: the gate's conflicts are where someone decides a breaking release.
  step "Library releases since $base_ref"
  release_status=0
  "$repo_root/bin/civic" release --config "$repo_root/civic.check.json" "${since[@]}" || release_status=$?
  if [ "$release_status" = 1 ]; then
    echo "A release above breaks a product override or unmaps a variant; its owners are asked to decide it."
  elif [ "$release_status" != 0 ]; then
    exit "$release_status"
  fi
fi
if [ "$browser" = 1 ]; then
  step "Fluent Button web evidence (Playwright)"
  pnpm --dir "$demo_dir/web" install --frozen-lockfile
  pnpm --dir "$demo_dir/web" run evidence
fi

step "CIVIC packages: canvas, shell and Vite connector, with the canvas examples"
pnpm --dir "$packages_dir" install --frozen-lockfile
pnpm --dir "$packages_dir" run check
pnpm --dir "$packages_dir" test

step "CIVIC packages installed from this commit into an empty app, opened in the standalone canvas"
node "$packages_dir/install.check.mjs"

# Checks may not touch tracked files; if they did, the result no longer describes HEAD.
if [ -n "$(git -C "$repo_root" status --porcelain)" ] || [ "$(git -C "$repo_root" rev-parse HEAD)" != "$sha" ]; then
  echo "The working tree changed while checks ran; not signing off." >&2
  exit 1
fi

scope="graph, review loop, importers, Button, Card and rebrand demos, Laundry and discovery graphs, civic gate, CIVIC packages and their install check"
[ "$browser" = 1 ] && scope="$scope + Button web evidence"
if [ "$post" = 0 ]; then step "Passed for $sha ($scope); status not posted"; exit 0; fi
if ! command -v gh >/dev/null; then step "Passed for $sha ($scope). Install the GitHub CLI (gh) to post the signoff status."; exit 0; fi

cd "$repo_root"
user="$(gh api user --jq .login)"
gh api --silent "repos/{owner}/{repo}/statuses/$sha" \
  -f state=success -f context=signoff \
  -f description="Signed off locally by $user: $scope"
step "Signed off $sha as $user ($scope)"
"$repo_root/bin/civic" check --config "$repo_root/civic.check.json" --post >/dev/null
step "Posted the civic gate status for $sha"
pr="$(gh pr view --json number,state --jq 'select(.state == "OPEN") | .number' 2>/dev/null || true)"
if [ -n "$pr" ] && [ "${#since[@]}" -gt 0 ]; then
  "$repo_root/bin/civic" check --config "$repo_root/civic.check.json" ${since[@]+"${since[@]}"} --comment "$pr" >/dev/null
  step "Put the change's findings, with who is asked and told, on pull request #$pr"
fi
