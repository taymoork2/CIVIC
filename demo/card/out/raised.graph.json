      "id": "semantic:card",
      "kind": "semantic-component",
      "title": "Card",
      "purpose": "Group related content and actions about one subject.",
      "owners": [
        {
          "role": "design",
          "who": "design-system-maintainers"
        },
        {
          "role": "qa",
          "who": "card-qa"
        }
      ],
      "variants": [
        {
          "key": "filled",
          "title": "Filled"
        },
        {
          "key": "outline",
          "title": "Outline"
        }
      ],
      "states": [
        "rest",
        "hover",
        "selected",
        "disabled",
        "loading",
        "empty",
        "error"
      ],
      "productStates": [
        "loading",
        "empty",
        "error"
      ],
      "slots": [
        "media",
        "header",
        "body",
        "actions"
      ],
      "rules": [
        {
          "key": "shape-from-token",
          "statement": "Corner radius comes from the shape token; a local radius is not allowed.",
          "forbids": {
            "property": "corner-radius",
            "change": "local-style"
          }
        }
      ],
      "source": {
        "tool": "civic",
