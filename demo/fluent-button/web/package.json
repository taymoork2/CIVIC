{
  "name": "@civic/demo-fluent-button-web",
  "private": true,
  "type": "module",
  "description": "Web evidence for the Fluent Button demo: renders Fluent React v9 Buttons and checks them with Playwright. Also exports Fluent's web tokens as DTCG.",
  "scripts": {
    "tokens": "node export-tokens.mjs ../tokens/fluent-web-light.tokens.json",
    "bundle": "esbuild src/harness.tsx --bundle --minify --outfile=dist/harness.js --define:process.env.NODE_ENV='\"production\"'",
    "evidence": "pnpm run bundle && playwright test",
    "evidence:record": "pnpm run bundle && CIVIC_REPORT=../evidence/playwright-report.json playwright test"
  },
  "devDependencies": {
    "@fluentui/react-components": "9.74.9",
    "@fluentui/tokens": "1.0.0-alpha.24",
    "@playwright/test": "1.56.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
