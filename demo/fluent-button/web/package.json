{
  "name": "@civic/demo-fluent-button-web",
  "private": true,
  "type": "module",
  "description": "Web evidence for the Fluent Button demo: renders Fluent React v9 Buttons and Fluent's own Button stories, and checks them with Playwright. Also exports Fluent's web tokens as DTCG.",
  "scripts": {
    "tokens": "node export-tokens.mjs ../tokens/fluent-web-light.tokens.json",
    "bundle": "esbuild src/harness.tsx --bundle --minify --outfile=dist/harness.js --define:process.env.NODE_ENV='\"production\"'",
    "bundle:story": "esbuild src/story-harness.tsx --bundle --format=esm --minify --outfile=dist/story-harness.js --define:process.env.NODE_ENV='\"production\"'",
    "evidence": "pnpm run bundle && pnpm run storybook:build && playwright test",
    "evidence:record": "pnpm run bundle && pnpm run storybook:build && CIVIC_REPORT=../evidence/playwright-report.json playwright test",
    "storybook:build": "storybook build --quiet --output-dir storybook-static"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.75.2",
    "@fluentui/react-icons": "^2.0.346",
    "@fluentui/react-utilities": "^9.27.0",
    "@fluentui/tokens": "1.0.0-alpha.24",
    "@playwright/test": "^1.65.1",
    "@storybook/react": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "vite": "^8.3.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
