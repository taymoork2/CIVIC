{
  "note": "Declared by Design Engineering: how each platform's Button and the Android Figma kit express the semantic Button's variants, after decision 0001's table. Importers check every name here against the source they read; they never guess a mapping.",
  "semanticId": "semantic:button",
  "platforms": [
    {
      "id": "platform:fluent-react-v9.button",
      "title": "Fluent React v9 Button",
      "platform": "web",
      "symbol": "Button",
      "owners": [{ "role": "design-engineering", "who": "fluent-web", "platform": "web" }],
      "variantProperty": "appearance",
      "variants": {
        "primary-filled": { "mapping": "exact", "expression": "primary" },
        "brand-outline": { "mapping": "closest", "expression": "outline", "note": "Fluent web's outline is neutral-coloured, not brand-coloured." },
        "neutral-default": { "mapping": "exact", "expression": "secondary" },
        "subtle": { "mapping": "exact", "expression": "subtle" },
        "transparent-neutral": { "mapping": "exact", "expression": "transparent" },
        "danger": { "mapping": "none", "note": "No base appearance." }
      },
      "extensionPoints": [
        { "name": "icon", "mechanism": "slot", "expresses": ["icon"] },
        { "name": "shape", "mechanism": "prop", "expresses": ["shape"] },
        { "name": "size", "mechanism": "prop", "expresses": ["size"] },
        { "name": "disabledFocusable", "mechanism": "prop", "expresses": ["state.disabled.focusable"] }
      ]
    },
    {
      "id": "platform:fluent-apple.button",
      "title": "Fluent iOS Button",
      "platform": "ios",
      "symbol": "Button",
      "owners": [{ "role": "design-engineering", "who": "fluent-ios", "platform": "ios" }],
      "variantProperty": "ButtonStyle",
      "variants": {
        "primary-filled": { "mapping": "exact", "expression": "accent" },
        "brand-outline": { "mapping": "exact", "expression": "outlineAccent" },
        "neutral-default": { "mapping": "exact", "expression": "outlineNeutral" },
        "subtle": { "mapping": "exact", "expression": "subtle" },
        "transparent-neutral": { "mapping": "exact", "expression": "transparentNeutral" },
        "danger": { "mapping": "exact", "expression": "danger", "note": "dangerOutline and dangerSubtle have no semantic variant yet." }
      },
      "extensionPoints": [
        { "name": "tokenSet", "mechanism": "token", "expresses": ["appearance", "shape"] },
        { "name": "image", "mechanism": "prop", "expresses": ["icon"] },
        { "name": "sizeCategory", "mechanism": "prop", "expresses": ["size"] }
      ]
    },
    {
      "id": "platform:fluent-android.compose-button",
      "title": "Fluent Android Compose Button",
      "platform": "android",
      "symbol": "Button",
      "owners": [{ "role": "design-engineering", "who": "fluent-android", "platform": "android" }],
      "variantProperty": "ButtonStyle",
      "variants": {
        "primary-filled": { "mapping": "exact", "expression": "Button" },
        "brand-outline": { "mapping": "exact", "expression": "OutlinedButton" },
        "neutral-default": { "mapping": "none", "note": "No stock ButtonStyle." },
        "subtle": { "mapping": "exact", "expression": "TextButton" },
        "transparent-neutral": { "mapping": "none", "note": "No stock ButtonStyle." },
        "danger": { "mapping": "none", "note": "Only through custom ButtonTokens." }
      },
      "extensionPoints": [
        { "name": "buttonTokens", "mechanism": "token", "expresses": ["appearance", "shape", "size"] },
        { "name": "icon", "mechanism": "prop", "expresses": ["icon"] },
        { "name": "size", "mechanism": "prop", "expresses": ["size"] }
      ]
    }
  ],
  "designKits": [
    {
      "id": "android-kit",
      "title": "Microsoft Fluent Android Figma kit",
      "platform": "android",
      "componentSet": "Button",
      "variantProperty": "Style",
      "owners": [{ "role": "design", "who": "design-system-maintainers" }],
      "variants": {
        "Primary": "primary-filled",
        "Outlined": "brand-outline",
        "Neutral": "neutral-default",
        "Text": "subtle"
      }
    }
  ]
}
