#!/usr/bin/env bash
# Starts the same stdio server for every harness.
set -euo pipefail
if ! civic_root="$("$(dirname "${BASH_SOURCE[0]}")/civic-home")"; then
  echo "CIVIC plugin: set CIVIC_HOME to a CIVIC checkout (one with review/src/mcp.ts)." >&2
  exit 1
fi
exec node "$civic_root/review/src/mcp.ts"
