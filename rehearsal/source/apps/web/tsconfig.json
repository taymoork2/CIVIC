{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@convex/*": ["../../convex/*"],
      "@washcloset/icons": ["../../packages/icons/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
