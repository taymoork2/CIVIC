+      } else if (input.operation === 'acknowledge') {
+        const c = store.candidates.find((c) => c.id === input.id)
+        if (!c) fail('Unknown coverage target')
+        c.acknowledged = true
+      } else fail('Unknown coverage operation')
+      store.version++; await write(store)
+      return result(store)
+    }),
+  }
+}
