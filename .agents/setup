#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
packages_dir="$repo_root/packages"
step() { printf '\n[%s] %s\n' "$(date +%H:%M:%S)" "$1"; }

step "CIVIC: installing CIVIC's packages"
time pnpm --dir "$packages_dir" install --frozen-lockfile

# Screen snapshots and review captures launch Playwright with the Google Chrome channel.
if [ ! -x /opt/google/chrome/chrome ]; then
  step "CIVIC: installing Google Chrome for review captures"
  time pnpm --dir "$packages_dir/canvas" exec playwright install --with-deps chrome
fi

# The review inventory requires Git; the workspace checkout provides it.
git -C "$repo_root" rev-parse HEAD >/dev/null
step "CIVIC: setup complete"
